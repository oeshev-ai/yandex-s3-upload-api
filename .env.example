PORT=3000
NODE_ENV=development

# Yandex Object Storage credentials
YC_ACCESS_KEY_ID=your_access_key_id
YC_SECRET_ACCESS_KEY=your_secret_access_key
YC_BUCKET_NAME=your-bucket-name
YC_REGION=ru-central1
YC_S3_ENDPOINT=https://storage.yandexcloud.net

# Signed URL lifetime in seconds
SIGNED_URL_EXPIRES_IN=300

# Comma-separated MIME whitelist. Empty means defaults from code.
ALLOWED_MIME_TYPES=image/jpeg,image/png,application/pdf

# CORS:
# - "*" allows all origins (development only)
# - For production set exact origins, comma-separated
#   Example: https://school.example.com,https://youraccount.getcourse.ru
CORS_ORIGINS=*

# JSON body size limit
JSON_BODY_LIMIT=1mb

# Teacher notifications (Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_TEACHER_CHAT_ID=
